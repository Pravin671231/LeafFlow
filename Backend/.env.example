PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/leafflow

# JWT - placeholder value; testKeys.ts generates a real secret at runtime if this is blank
ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
ACCESS_SECRET=test_access_secret_placeholder_32chars
REFRESH_SECRET=test_refresh_secret_placeholder_32ch

# OAuth
GOOGLE_CLIENT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_link_to_email
MAIL_FROM=no-reply@leafflow.com

# Admin seed credentials
ADMIN_LOGIN_EMAIL=admin@leafflow.com
ADMIN_OTP_EMAIL=admin-otp@leafflow.com
ADMIN_PASSWORD=change_me_in_production

# App
CORS_ORIGIN=http://localhost:3001,http://localhost:5173
# Defaults to "debug" (development) / "info" (production). Override here if needed.
LOG_LEVEL=info
