PORT=3000
NODE_ENV=test
MONGODB_URI=mongodb://localhost:27017/leafflow_test

# JWT — placeholder value; testKeys.ts generates a real secret at runtime if this is blank
ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
ACCESS_SECRET=test_access_secret_placeholder_32chars
REFRESH_SECRET=test_refresh_secret_placeholder_32ch

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Email (fake SMTP — email is mocked in tests)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=test_password
MAIL_FROM=no-reply@leafflow.com
